---
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/main.css';
import { site } from '../site';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
const isActive = (url: string) => (url === '/' ? path === '/' || path === '/index.html' : path.startsWith(url));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} :: {site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="keywords" content="blog" />
    <meta name="author" content={site.author} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/feed.xml" />
  </head>

  <body id="top">
    <nav class="navbar navbar-expand-sm navbar-dark bg-primary sticky-top" data-bs-theme="dark">
      <div class="container">
        <a class="navbar-brand" href="/"><strong>Y</strong>et <strong>A</strong>nother <strong>TE</strong>ch b<strong>L</strong>og</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
          <ul class="navbar-nav me-auto">
            {site.menu.map((item) => (
              <li class="nav-item">
                <a class:list={['nav-link', { active: isActive(item.url) }]} href={item.url} aria-label={item.label} aria-current={isActive(item.url) ? 'page' : undefined}>{item.title}</a>
              </li>
            ))}
          </ul>
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="http://yatel.kramolis.cz">Old Blog</a>
            </li>
            <li class="nav-item my-auto">
              <a class="nav-link py-0" href="https://libor.kramolis.cz">
                <img src="/assets/shamoh.jpg" alt="Libor Kramoliš" class="rounded-circle" style="width: 24px" />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div role="main" class="container">
      <slot />
    </div>

    <footer class="bg-primary text-white footer">
      <div class="container">
        <span class="float-end">
          <a href="#top" class="text-white" aria-label="Back to top">&#x25B2;</a>
        </span>
        <span>&#x00A9; <Fragment set:html={site.email} /> 2018</span>
      </div>
    </footer>

    <script>
      import 'bootstrap/js/dist/collapse';
    </script>
  </body>
</html>
